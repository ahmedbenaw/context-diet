# The fixture ships as ordinary tracked files with no .git of its own. The
# harness copies it to a workspace and runs git init there, so it can reset
# between trials without the parent repo ever holding an embedded gitlink that
# nobody can clone usefully. The ignore below covers a .git only if someone
# runs git inside the fixture by hand.
plugins/context-diet/fixture/.git/
plugins/context-diet/fixture/node_modules/
plugins/context-diet/fixture/answer.txt

# Local environment, not part of the plugin.
.venv/
.uv-cache/
.tiktoken-cache/

# Measurement output belongs to the machine that produced it. At any depth:
# a pattern with a slash in the middle is anchored to the repo root, and the
# 0.1.0 hooks wrote state under plugins/, scripts/ and tests/ that git then
# offered to commit, home paths and all.
**/.claude/context-diet/
out/
**/__pycache__/
*.pyc

# Generated fixtures. Rebuild with tests/make_fixtures.py --heavy.
plugins/context-diet/tests/fixtures/big-store/

# Local hookify rules, personal to this machine
.claude/hookify.*.local.md

# macOS directory metadata, never part of the plugin.
.DS_Store
**/.DS_Store

# The v4 source tree is an input to the merge, not part of the plugin. The four
# items Part 12.4 names are ported into plugins/context-diet; the rest stays out.
incoming-v4/

# refactor-chain board state, local to a session.
.refactor-chain/
