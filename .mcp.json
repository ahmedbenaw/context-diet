{
  "mcpServers": {
    "mlflow-mcp": {
      "args": [
        "run",
        "--with",
        "mlflow[mcp]>=3.5.1",
        "mlflow",
        "mcp",
        "run"
      ],
      "command": "uv",
      "env": {
        "MLFLOW_TRACKING_URI": "sqlite:///./.claude/context-diet/mlflow.db"
      }
    }
  }
}
